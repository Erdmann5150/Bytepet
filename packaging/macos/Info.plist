<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>             <string>Bytepet</string>
    <key>CFBundleDisplayName</key>      <string>Bytepet</string>
    <key>CFBundleIdentifier</key>       <string>com.bytepet.desktop</string>
    <key>CFBundleExecutable</key>       <string>bytepet</string>
    <key>CFBundleIconFile</key>         <string>icon</string>
    <key>CFBundlePackageType</key>      <string>APPL</string>
    <key>CFBundleShortVersionString</key><string>VERSION</string>
    <key>CFBundleVersion</key>          <string>VERSION</string>
    <key>LSMinimumSystemVersion</key>   <string>11.0</string>
    <!-- A desktop widget: no Dock icon, no menu bar; it lives in the status bar. -->
    <key>LSUIElement</key>              <true/>
    <key>NSHighResolutionCapable</key>  <true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Bytepet finds and links with other Bytepets on your local network.</string>
</dict>
</plist>
